# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
dist/
build/

# Local
*.log
# `uv.lock` est VERSIONNE (ne pas le remettre ici) : c'est lui qui rend les
# installations reproductibles (`uv sync` fige les versions exactes).

# Interface terminal (tui/) : Bun et @opentui/core s'installent localement
# (le package-lock.json, lui, reste versionnable : il fige les versions)
node_modules/
aura/.cache_routeur/
# Index des documents locaux (aura/documents.py) : donnees privees, jamais git
.cache_docs/

# Modeles (trop gros pour git : telecharge via scripts/telecharger_llama.py)
modeles/
.cache_corrections.jsonl
aura/.cache_reponses.jsonl
*.vecs.npy
aura_system.aef
.cache_aef/
secret_aef.txt
.secret_aef.txt

# Serveur llama.cpp (binaire officiel + adaptateurs transposes + zips)
serveur/

# cles de signature : JAMAIS commitées
*aef.sig
cle_privee.pem
cle_publique.pub
Aura.spec
# PyInstaller ecrit un .spec a cote du script a chaque build (scripts/construire_exe.py)
RontoGPT.spec
aura_system.aef.enc
# sauvegardes d'artefacts .aef (rollback local, jamais dans git)
aura_system.aef*.bak*
aura/.conversation.jsonl
eval_*.json
hf*.log

# Sorties de benchmarks / diagnostics (regenerables, a la racine)
banc_100_*.json
banc_100.*.json
banc_100_cache*.jsonl
bench_*.json
bench_*.jsonl
*.flag
mic_levels.txt
captures_gui/
.mypy_cache/

# Fichiers historiques / sorties de build qui ne servent pas à l'exécution
adaptateurs/_archive_llama_3.2/
assets_hf/aura.png

# Donnees locales / privees de l'utilisateur (jamais dans git)
aura/.conversation.etat.json
aura/.graphe_faits.jsonl

# Sauvegardes locales
*.bak*

# Corbeille de travail locale (copies mortes, sauvegardes de cache) : le
# contenu est la pour etre jete, pas pour entrer dans l'historique.
_to_delete/

# Votes utilisateur locaux
aura/feedback.jsonl

# Secrets locaux
.env

# Rapports de couverture (`pytest --cov`) : fichiers GENERES, jamais livres.
# Sans ces deux lignes, le premier `uv run pytest --cov` d'un contributeur
# laisse un `.coverage` non suivi a la racine du depot.
.coverage
.coverage.*
htmlcov/
coverage.xml
